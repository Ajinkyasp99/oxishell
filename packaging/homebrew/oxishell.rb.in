# Homebrew formula template. The release workflow fills in @VERSION@ and
# @SHA256@ and pushes the result to the tap repository
# (Ajinkyasp99/homebrew-oxishell, as Formula/oxishell.rb).
# Install: brew install --formula Ajinkyasp99/oxishell/oxishell
# (CLI binaries only; the app comes from the cask, oxishell-cask.rb.in.)
class Oxishell < Formula
  desc "Terminal workspace manager for AI coding agents"
  homepage "https://github.com/Ajinkyasp99/oxishell"
  url "https://github.com/Ajinkyasp99/oxishell/archive/refs/tags/v@VERSION@.tar.gz"
  sha256 "@SHA256@"
  license "GPL-3.0-or-later"
  head "https://github.com/Ajinkyasp99/oxishell.git", branch: "main"

  depends_on "pkgconf" => :build
  depends_on "rust" => :build
  depends_on "adwaita-icon-theme"
  depends_on "gtk4"
  depends_on "libadwaita"
  depends_on "librsvg"
  depends_on "vte3"

  def install
    system "cargo", "install", *std_cargo_args
  end

  def caveats
    <<~EOS
      Start it with `oxishell` (the `oxi` CLI is installed too).
      This formula installs command-line binaries only, so Oxishell does not
      appear in /Applications or Launchpad. For the app, use the cask instead:
        brew uninstall --formula oxishell
        brew install --cask Ajinkyasp99/oxishell/oxishell
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/oxi --version")
  end
end
